# Copy to .env. All settings use the REPOLENS_ prefix (see backend/repolens/config.py).
POSTGRES_PASSWORD=change-me
REPOLENS_ENV=dev                        # use "prod" for real deployments (enforces secrets + https Jira)
REPOLENS_JWT_SECRET=change-me-to-a-long-random-string
# Fernet key for Jira tokens at rest:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REPOLENS_SECRET_KEY=

# LLM: heuristic (default, fully offline, no model calls) | anthropic | openai (any OpenAI-compatible API)
REPOLENS_LLM_PROVIDER=heuristic
REPOLENS_LLM_MODEL=claude-sonnet-5-5
REPOLENS_LLM_API_KEY=
# Versioned pricing, USD per 1M tokens. Without it costs are reported as $0 ("unpriced").
# REPOLENS_PRICING_JSON={"claude-sonnet-5-5":{"input":3.0,"output":15.0,"cached_input":0.3}}
REPOLENS_PRICING_VERSION=2026-10-01
REPOLENS_DAILY_BUDGET_USD=0
REPOLENS_MONTHLY_BUDGET_USD=0

# Embeddings: hash (local/offline) | openai (OpenAI-compatible). Raise the similarity floor for hosted models.
REPOLENS_EMBEDDING_PROVIDER=hash
# REPOLENS_VECTOR_MIN_SIMILARITY=0.3

# Local-path repositories must live under these roots when ENV != dev (JSON list)
REPOLENS_LOCAL_REPO_ROOTS=["/mnt/repos"]
REPOLENS_GITHUB_WEBHOOK_SECRET=
REPOLENS_OTLP_ENDPOINT=                 # e.g. http://jaeger:4318/v1/traces

# --- hardening (defaults are safe; see SECURITY.md) ---
# Proxies in front of the API that append to X-Forwarded-For (compose: 1 = the web container; Kubernetes: 2 = ingress + web).
# Leave 0 when clients reach the API directly, otherwise the client address (rate limits) cannot be trusted.
REPOLENS_TRUSTED_PROXY_HOPS=0
# REPOLENS_RATE_LIMIT_IP_PER_MINUTE=600
# REPOLENS_RATE_LIMIT_USER_PER_MINUTE=1200
# REPOLENS_RATE_LIMIT_HEAVY_PER_MINUTE=30      # model-backed and indexing calls
# REPOLENS_RATE_LIMIT_AUTH_PER_MINUTE=20       # sign-in / registration / SSO discovery, per address
# REPOLENS_MAX_BODY_MB=32
# REPOLENS_MAX_UPLOAD_MB=100   # document imports only: several files, each up to 25 MB
# REPOLENS_METRICS_TOKEN=                      # set to require a bearer token on /metrics
# REPOLENS_SESSION_IDLE_MINUTES=480
